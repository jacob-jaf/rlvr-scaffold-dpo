{
  "base_model": "Qwen/Qwen3-8B",
  "load_in_4bit": true,
  "learning_rate": 5e-05,
  "num_train_epochs": 20.0,
  "max_steps": 300,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 1,
  "max_seq_length": 6144,
  "eval_strategy": "steps",
  "eval_steps": 25,
  "save_steps": 25,
  "logging_steps": 1,
  "warmup_ratio": 0.0,
  "lr_scheduler_type": "constant",
  "bf16": true,
  "fp16": false,
  "gradient_checkpointing": true,
  "lora_r": 64,
  "lora_alpha": 128,
  "lora_dropout": 0.0,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "report_to": "none",
  "seed": 42,
  "loss_masking": "assistant_final_response_only",
  "max_grad_norm": 1.0
}
